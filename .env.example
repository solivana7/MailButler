# =============================================
# MailMind Environment Configuration
# =============================================

# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-app.railway.app
SERVER_URL=https://your-app.railway.app

# Database (Neon PostgreSQL)
# Get a free database at https://neon.tech
# Leave empty to run in demo mode with seeded data
DATABASE_URL=postgresql://user:password@host/database

# Kimi AI (Moonshot AI) - for advanced AI features
# Get a key at https://platform.moonshot.cn
KIMI_API_KEY=your-kimi-api-key

# Google OAuth (for Gmail integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
