# Backend Dockerfile - Multi-stage build
# Builds both the backend API and the frontend SPA, then serves the SPA from the backend.
FROM node:20-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable

# Copy root (frontend) package files
COPY package.json pnpm-lock.yaml .npmrc ./

# Copy server (backend) package files
COPY server/package.json server/pnpm-lock.yaml server/.npmrc ./server/

# Install dependencies using frozen lockfiles
RUN pnpm install --frozen-lockfile
RUN cd server && pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build the frontend SPA
RUN pnpm exec tsc -b && pnpm exec vite build

# Build the backend API
RUN cd server && pnpm run build

# Production stage - only production dependencies
FROM node:20-alpine

WORKDIR /app

RUN corepack enable

# Copy server package files and install production dependencies only
COPY server/package.json server/pnpm-lock.yaml server/.npmrc ./server/
RUN cd server && pnpm install --prod --frozen-lockfile

# Copy built backend and frontend
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/dist ./dist

# Set environment
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "server/dist/index.js"]
